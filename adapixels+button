#include <Adafruit_NeoPixel.h>

#define LED_PIN    3
#define LED_COUNT 3

const int buttonPin = 2; 
int buttonState = 0;

Adafruit_NeoPixel pixels(LED_COUNT, LED_PIN, NEO_GRB + NEO_KHZ800);
int r = 0;
bool strobe = false;
int blinks = 50;

void blinky(){
  if(!strobe){
    pixels.setPixelColor(0, pixels.Color(r, 0, 0));
    pixels.setPixelColor(1, pixels.Color(r, 0, 0));
    pixels.setPixelColor(2, pixels.Color(r, 0, 0));
    pixels.show();
    r = r + 2;
    delay(100);
    if(r >= 255){
      strobe = true;
    }
  }
  else{
    if (blinks > 0){
      blinks--;
      uint32_t c = pixels.getPixelColor(0);
      r = (c >> 16) & 0xFF;

      if(r != 0){
        pixels.setPixelColor(0, pixels.Color(0, 0, 0));
        pixels.setPixelColor(1, pixels.Color(0, 0, 0));
        pixels.setPixelColor(2, pixels.Color(0, 0, 0));
      }
      else{
        pixels.setPixelColor(0, pixels.Color(255, 0, 0));
        pixels.setPixelColor(1, pixels.Color(255, 0, 0));
        pixels.setPixelColor(2, pixels.Color(255, 0, 0));
      }
      pixels.show();
      delay(30);
    }
    else{
      r = 0;
      blinks = 50;
      strobe = false;
      pixels.setPixelColor(0, pixels.Color(255, 0, 0));
      pixels.setPixelColor(1, pixels.Color(255, 0, 0));
      pixels.setPixelColor(2, pixels.Color(255, 0, 0));
      pixels.show();
      delay(1000);
      pixels.setPixelColor(0, pixels.Color(0, 0, 0));
      pixels.setPixelColor(1, pixels.Color(0, 0, 0));
      pixels.setPixelColor(2, pixels.Color(0, 0, 0));
      pixels.show();
      delay(2000);
    }
  }
}

void normal(){
  pixels.setPixelColor(0, pixels.Color(0, 250, 0));
  pixels.setPixelColor(1, pixels.Color(0, 250, 0));
  pixels.setPixelColor(2, pixels.Color(0, 250, 0));
  pixels.show();
   delay(50);
  // delay(5000);
}

void setup() {
  pinMode(buttonPin, INPUT_PULLUP);
  Serial.begin(9600);

  pixels.begin();           
  pixels.setBrightness(255); 
 
  pixels.show();            

}
void loop() {
  
  
  buttonState = digitalRead(buttonPin);
  
  // Print the button state
  if (buttonState == LOW) {
    Serial.println("Button Pressed");
    blinky();
  } else {
    Serial.println("Button Released");
    normal();
  }
  
  // Add a small delay for debouncing
 
  
  // Serial.writeln(buttonState == HIGH);
  // if (buttonState == HIGH) {
  //   normal();
  // } else {
  //   blinky();
  // }
  
}
